# ============================================================================
#  mr_embed.cmake - embed a file into a C++ source as a byte array.
#
#  Run in script mode:
#    cmake -DINPUT=<file or empty> -DOUTPUT=<file.cpp> -DSYMBOL=<name>
#          -P mr_embed.cmake
#
#  Writes
#    extern "C" const unsigned char      <SYMBOL>_data[];  // bytes + a NUL
#    extern "C" const unsigned long long <SYMBOL>_size;    // without the NUL
#
#  The trailing NUL lets a text file be used as a C string. An empty INPUT
#  produces an empty array (size 0); the Metal backend uses that to signal
#  "no precompiled metallib, compile the embedded source instead".
# ============================================================================

if(NOT DEFINED OUTPUT OR NOT DEFINED SYMBOL)
    message(FATAL_ERROR "mr_embed.cmake needs -DOUTPUT=... and -DSYMBOL=...")
endif()

set(hex "")
if(DEFINED INPUT AND NOT INPUT STREQUAL "")
    file(READ "${INPUT}" hex HEX)
endif()
string(LENGTH "${hex}" nhex)
math(EXPR nbytes "${nhex} / 2")

# "0a1b..." -> "0x0a,0x1b,..." with a line break every 16 bytes.
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n    " bytes "${bytes}")

file(WRITE "${OUTPUT}.tmp"
"/* Generated by cmake/mr_embed.cmake from ${INPUT}. Do not edit. */\n"
"extern \"C\" const unsigned char ${SYMBOL}_data[] = {\n    ${bytes}0x00};\n"
"extern \"C\" const unsigned long long ${SYMBOL}_size = ${nbytes}ULL;\n")
# Only touch OUTPUT when it changes, to avoid needless recompiles.
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
